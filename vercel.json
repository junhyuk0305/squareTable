{
  "buildCommand": "npx expo export -p web && node scripts/inject-landing-redirect.mjs && node scripts/seo-postbuild.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/account-deletion", "destination": "/account-deletion.html" },
    { "source": "/ai-policy", "destination": "/ai-policy.html" },
    { "source": "/dpa", "destination": "/dpa.html" },
    { "source": "/inquiry", "destination": "/inquiry.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/cafe", "destination": "/cafe.html" },
    { "source": "/restaurant", "destination": "/restaurant.html" },
    { "source": "/gym", "destination": "/gym.html" },
    { "source": "/academy", "destination": "/academy.html" },
    { "source": "/faq", "destination": "/pricing.html" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
