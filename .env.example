# 복사해서 .env 로 쓰세요:  cp .env.example .env
# 실제 값은 Supabase 대시보드 > Project Settings > API 에서 복사.

EXPO_PUBLIC_SUPABASE_URL=https://htestcrcphssgnljdwyh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_w8qVLNJBz8lCjyrNF13BKw_1n6eaSBn
EXPO_PUBLIC_USE_MOCK=true

# 웹푸시 VAPID 공개키(공개 가능). node scripts/generate-vapid-keys.mjs 로 생성.
# 같은 키쌍의 비밀키는 supabase secrets(VAPID_PRIVATE_KEY)로만 — .env 에 넣지 말 것.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# PostHog 제품 분석(DAU/리텐션/퍼널). 키는 posthog.com > Project Settings > API Key(phc_*).
# 공개 가능한 write-only 키. 비우면 전송 안 함(로컬 개발 기본) — 프로덕션은 Vercel env 에만 설정.
EXPO_PUBLIC_POSTHOG_KEY=
# 기본 https://us.i.posthog.com — EU 리전이면 https://eu.i.posthog.com 로 교체.
# EXPO_PUBLIC_POSTHOG_HOST=
